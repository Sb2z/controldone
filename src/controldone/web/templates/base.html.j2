<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#05060a">
{% block meta %}{% endblock %}
<title>{{ titre }} — ControlDOne</title>
<link rel="preload" href="/static/vendor/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/app.css">
<script src="/static/theme.js"></script>
<script src="/static/vendor/motion.min.js" defer></script>
<script src="/static/app.js" defer></script>
</head>
<body class="{% block corps_classe %}{% endblock %}">
<a class="evitement" href="#contenu">Aller au contenu</a>
<div class="decor" aria-hidden="true"><div class="halo h1"></div><div class="halo h2"></div><div class="halo h3"></div><div class="trame"></div><div class="grain"></div></div>
<div class="progression" aria-hidden="true"></div>
{% if demo %}
<div class="bandeau-demo" role="note"><strong>DONNÉES FICTIVES</strong> — client de démonstration : sociétés, documents et montants inventés.</div>
{% endif %}
<header class="entete">
  <div class="entete-int">
    <a class="marque" href="/" aria-label="ControlDOne — accueil">
      <svg class="logo" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <defs><linearGradient id="logo-degrade" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse"><stop stop-color="#8b9cff"/><stop offset=".5" stop-color="#b69cff"/><stop offset="1" stop-color="#5eead4"/></linearGradient></defs>
        <rect x="1.5" y="1.5" width="29" height="29" rx="9" stroke="url(#logo-degrade)" stroke-width="1.6" opacity=".9"/>
        <path d="M9.5 12.5h8M9.5 16.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".55"/>
        <path class="trace" d="M14.5 21.2l3.2 3.1 6.6-7.6" stroke="url(#logo-degrade)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span aria-hidden="true" class="marque-texte">Control<span>DOne</span></span>
    </a>
    {% if acteur %}
    <nav class="nav" aria-label="Navigation principale">
      {% if acteur.role.value == "fondateur" %}
        {% set liens = [("tableau", "/admin", "Tableau de bord"), ("validation", "/admin/validation", "File de validation"), ("clients", "/admin/clients", "Clients"), ("finances", "/admin/finances", "Finances"), ("jobs", "/admin/jobs", "Tâches"), ("journal", "/admin/journal", "Journal"), ("alertes", "/admin/alertes", "Alertes"), ("autonomie", "/admin/autonomie", "Autonomie")] %}
      {% else %}
        {% set liens = [("tableau", "/espace", "Tableau de bord"), ("depot", "/espace/depot", "Déposer"), ("dossiers", "/espace/dossiers", "Dossiers"), ("rapports", "/espace/rapports", "Rapports"), ("recouvrement", "/espace/recouvrement", "Suivi des avoirs")] %}
      {% endif %}
      <ul>
      {% for cle, url, lib in liens %}
        <li><a href="{{ url }}"{% if nav == cle %} aria-current="page"{% endif %}>{{ lib }}</a></li>
      {% endfor %}
      </ul>
    </nav>
    <div class="compte">
      <button type="button" class="btn-icone seulement-js" data-palette-ouvrir aria-label="Recherche rapide (Ctrl+K)" title="Recherche rapide (Ctrl+K)">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M13.2 13.2L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><kbd>Ctrl K</kbd>
      </button>
      <span class="role">{{ "Fondateur" if acteur.role.value == "fondateur" else ("Administrateur client" if acteur.role.value == "client_admin" else "Lecteur") }}</span>
      <a href="/compte/mot-de-passe" class="btn-icone" title="Mot de passe"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="7" cy="10" r="3.4" stroke="currentColor" stroke-width="1.6"/><path d="M10.4 10H17.5M15 10v2.6M17.5 10v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span class="vh">Mot de passe</span></a>
      <form method="post" action="/deconnexion" class="en-ligne">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <button type="submit" class="btn-icone" title="Se déconnecter"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8 4H5.5A1.5 1.5 0 004 5.5v9A1.5 1.5 0 005.5 16H8M12.5 13.5L16 10l-3.5-3.5M16 10H8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Se déconnecter</span></button>
      </form>
    </div>
    {% endif %}
    <button type="button" class="btn-icone seulement-js" data-theme-basculer aria-label="Basculer le thème clair ou sombre" title="Thème clair / sombre">
      <svg class="ico-lune" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.5 12.3A6.8 6.8 0 017.7 3.5a6.8 6.8 0 108.8 8.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <svg class="ico-soleil" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.6"/><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
<main id="contenu" class="page">
  {% if flash %}
  <div class="message {{ 'erreur' if flash.e else 'succes' }}" role="{{ 'alert' if flash.e else 'status' }}">{{ flash.m }}</div>
  {% endif %}
  {% block contenu %}{% endblock %}
</main>
<footer class="pied">
  <p class="avertissement"><strong>Avertissement.</strong> {{ AVERTISSEMENT }}</p>
  <p class="mentions">ControlDOne — contrôle technique de cohérence des documents d'import. Les relevés d'écarts sont remis au client, qui décide seul de leur usage.</p>
</footer>
{% if acteur %}
<dialog class="palette" data-palette aria-label="Recherche rapide">
  <div class="palette-champ">
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M13.2 13.2L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <input type="text" placeholder="Aller à une page, une section, une action…" aria-label="Rechercher" role="combobox" aria-expanded="true" aria-controls="palette-liste" autocomplete="off" spellcheck="false">
    <kbd>Échap</kbd>
  </div>
  <ul id="palette-liste" role="listbox"></ul>
</dialog>
{% endif %}
</body>
</html>
