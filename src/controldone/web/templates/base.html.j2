<!doctype html>
<html lang="{{ langue }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e1114" media="(prefers-color-scheme: dark)">
{% block meta %}{% endblock %}
<title>{{ titre }} · ControlDOne</title>
<link rel="preload" href="/static/vendor/fonts/SourceSerif4Variable-Roman.ttf.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/static/app.css">
<script src="/static/theme.js"></script>
<script src="/static/vendor/motion.min.js" defer></script>
<script src="/static/app.js" defer></script>
</head>
<body class="{% block corps_classe %}{% endblock %}">
<a class="evitement" href="#contenu">{{ _("Aller au contenu") }}</a>
<div class="progression" aria-hidden="true"></div>
{% if demo %}
<aside class="bandeau-demo" aria-label="{{ _("Données fictives") }}"><strong>{{ _("DONNÉES FICTIVES") }}</strong> · {{ _("Client de démonstration : les sociétés, les documents et les montants sont inventés.") }}</aside>
{% endif %}
<header class="entete">
  <div class="entete-int">
    <a class="marque" href="/" aria-label="{{ _("ControlDOne, accueil") }}">
      <svg class="logo" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect class="cadre" x="2" y="2" width="28" height="28" rx="8" stroke-width="1.5"/>
        <path d="M9.5 12.5h8M9.5 16.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".5"/>
        <path class="trace" d="M14.5 21.2l3.2 3.1 6.6-7.6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span aria-hidden="true" class="marque-texte">Control<span>DOne</span></span>
    </a>
    {% if acteur %}
    <nav class="nav" aria-label="{{ _("Navigation principale") }}">
      {% if acteur.role.value == "fondateur" %}
        {% set liens = [("tableau", "/admin", _("Tableau de bord")), ("validation", "/admin/validation", _("File de validation")), ("clients", "/admin/clients", _("Clients")), ("finances", "/admin/finances", _("Finances")), ("jobs", "/admin/jobs", _("Tâches")), ("journal", "/admin/journal", _("Journal")), ("alertes", "/admin/alertes", _("Alertes")), ("autonomie", "/admin/autonomie", _("Autonomie")), ("prospection", "/admin/prospection", _("Marketing"))] %}
      {% else %}
        {% set liens = [("tableau", "/espace", _("Tableau de bord")), ("depot", "/espace/depot", _("Déposer")), ("dossiers", "/espace/dossiers", _("Dossiers")), ("rapports", "/espace/rapports", _("Rapports")), ("recouvrement", "/espace/recouvrement", _("Suivi des avoirs"))] %}
      {% endif %}
      <ul>
      {% for cle, url, lib in liens %}
        <li><a href="{{ url }}"{% if nav == cle %} aria-current="page"{% endif %}>{{ lib }}</a></li>
      {% endfor %}
      </ul>
    </nav>
    <div class="compte">
      <button type="button" class="btn-icone seulement-js" data-palette-ouvrir aria-label="{{ _("Recherche rapide (Ctrl+K)") }}" title="{{ _("Recherche rapide (Ctrl+K)") }}">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M13.2 13.2L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><kbd>Ctrl K</kbd>
      </button>
      <span class="role">{{ _("Fondateur") if acteur.role.value == "fondateur" else (_("Administrateur client") if acteur.role.value == "client_admin" else _("Lecteur")) }}</span>
      <a href="/compte" class="btn-icone" title="{{ _("Mon compte") }}"{% if nav == "compte" %} aria-current="page"{% endif %}><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="7" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M3.8 16.5c.9-2.9 3.3-4.4 6.2-4.4s5.3 1.5 6.2 4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span class="vh">{{ _("Mon compte") }}</span></a>
      <a href="/compte/sessions" class="btn-icone" title="{{ _("Mes sessions actives") }}"{% if nav == "sessions" %} aria-current="page"{% endif %}><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4" width="15" height="10" rx="1.6" stroke="currentColor" stroke-width="1.6"/><path d="M7 17h6M10 14v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span class="vh">{{ _("Mes sessions actives") }}</span></a>
      <a href="/compte/mot-de-passe" class="btn-icone" title="{{ _("Mot de passe") }}"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="7" cy="10" r="3.4" stroke="currentColor" stroke-width="1.6"/><path d="M10.4 10H17.5M15 10v2.6M17.5 10v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span class="vh">{{ _("Mot de passe") }}</span></a>
      <form method="post" action="/deconnexion" class="en-ligne">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <button type="submit" class="btn-icone" title="{{ _("Se déconnecter") }}"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8 4H5.5A1.5 1.5 0 004 5.5v9A1.5 1.5 0 005.5 16H8M12.5 13.5L16 10l-3.5-3.5M16 10H8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">{{ _("Se déconnecter") }}</span></button>
      </form>
    </div>
    {% endif %}
    {% set autre = "en" if langue == "fr" else "fr" %}
    <form method="post" action="/preferences/langue" class="en-ligne choix-langue">
      <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="retour" value="{{ retour_langue }}">
      <button type="submit" name="langue" value="{{ autre }}" class="btn-icone btn-langue" lang="{{ autre }}" title="{{ LANGUES[autre] }}"><span aria-hidden="true">{{ autre|upper }}</span><span class="vh">{{ LANGUES[autre] }}</span></button>
    </form>
    <button type="button" class="btn-icone seulement-js" data-theme-basculer aria-label="{{ _("Passer en thème clair ou sombre") }}" title="{{ _("Thème clair ou sombre") }}">
      <svg class="ico-lune" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.5 12.3A6.8 6.8 0 017.7 3.5a6.8 6.8 0 108.8 8.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <svg class="ico-soleil" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.6"/><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
<main id="contenu" class="page">
  {% if flash %}
  <div class="message {{ 'erreur' if flash.e else 'succes' }}" role="{{ 'alert' if flash.e else 'status' }}"><span class="texte">{{ flash.m }}</span></div>
  {% endif %}
  {% block contenu %}{% endblock %}
</main>
<footer class="pied">
  <p class="avertissement" lang="fr"><strong>Avertissement.</strong> {{ AVERTISSEMENT }}</p>
  {% if langue == "en" %}<p class="avertissement traduction"><strong>Courtesy translation (the French text above prevails):</strong> {{ AVERTISSEMENT_EN }}</p>{% endif %}
  <p class="mentions">{{ _("ControlDOne compare vos documents d'import entre eux et chiffre les écarts. Les relevés vous sont remis : vous décidez seul de ce que vous en faites.") }}</p>
</footer>
{% if acteur %}
<dialog class="palette" data-palette aria-label="{{ _("Recherche rapide") }}">
  <div class="palette-champ">
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M13.2 13.2L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <input type="text" placeholder="{{ _("Aller à une page, une section, une action…") }}" aria-label="{{ _("Rechercher") }}" role="combobox" aria-expanded="true" aria-controls="palette-liste" autocomplete="off" spellcheck="false">
    <kbd>{{ _("Échap") }}</kbd>
  </div>
  <ul id="palette-liste" role="listbox"></ul>
</dialog>
{% endif %}
<script type="application/json" id="cd-textes">{{ textes_js|tojson }}</script>
</body>
</html>
