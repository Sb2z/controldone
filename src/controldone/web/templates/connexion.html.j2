{% extends "base.html.j2" %}
{% block corps_classe %}corps-auth{% endblock %}
{% block contenu %}
<div class="accueil">
  <div class="accueil-texte">
    <span class="etiquette">{{ _("Contrôle des factures de transitaire") }}</span>
    <h1>{{ _("Chaque ligne de la facture de votre transitaire,") }} <span class="attenue">{{ _("comparée à votre déclaration en douane.") }}</span></h1>
    <p class="chapeau">{{ _("Pour chaque envoi, ControlDOne met côte à côte la facture du fournisseur, la déclaration, la facture du transitaire et ses avoirs. Chaque écart est chiffré au centime, avec les deux montants et la page où ils figurent.") }}</p>
    <ol class="etapes">
      <li><b>01</b><strong>{{ _("Vous déposez vos documents tels quels.") }}</strong><span>{{ _("PDF, scans, XML, CSV ou archives ZIP.") }}</span></li>
      <li><b>02</b><strong>{{ _("Un programme fait les calculs.") }}</strong><span>{{ _("Les mêmes documents donnent toujours le même résultat. Un modèle de langage peut aider à lire une page, jamais à calculer.") }}</span></li>
      <li><b>03</b><strong>{{ _("Le fondateur relit chaque constat.") }}</strong><span>{{ _("Vous recevez un relevé vérifié et vous décidez seul de la suite.") }}</span></li>
    </ol>
    <figure class="exemple" data-exemple aria-labelledby="exemple-titre">
      <figcaption class="exemple-tete"><span class="etiquette" id="exemple-titre">{{ _("Exemple de constat, données fictives") }}</span><span class="etiquette">{{ _("Droits de douane") }}</span></figcaption>
      <dl class="exemple-lignes">
        <dt>{{ _("Facture du transitaire") }}<small>{{ _("page 1, ligne « Droits de douane »") }}</small></dt><dd data-exemple-valeur>{{ "1284.00"|montant }}</dd>
        <dt>{{ _("Déclaration en douane (DAU)") }}<small>{{ _("page 2, case 47") }}</small></dt><dd data-exemple-valeur>{{ "1032.00"|montant }}</dd>
      </dl>
      <div class="exemple-trait" aria-hidden="true"></div>
      <dl class="exemple-lignes">
        <dt class="ecart" data-exemple-ecart>{{ _("Écart constaté") }}<small>{{ _("tolérance 0,05 EUR") }}</small></dt><dd class="ecart" data-exemple-ecart>{{ "252.00"|montant }}</dd>
      </dl>
    </figure>
  </div>
  <section class="carte carte-connexion" aria-labelledby="titre-connexion">
    <h2 id="titre-connexion">{{ _("Connexion") }}</h2>
    <p class="discret">{{ _("Espace réservé aux clients de ControlDOne. Le compte du fondateur demande en plus un code à usage unique.") }}</p>
    {% if erreur is defined %}<div class="message erreur" role="alert">{{ erreur }}</div>{% endif %}
    <form method="post" action="/connexion" class="formulaire">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <label for="email">{{ _("Adresse électronique") }}</label>
      <input id="email" name="email" type="email" autocomplete="username" required maxlength="320" value="{{ email if email is defined else '' }}" autofocus>
      <label for="mdp">{{ _("Mot de passe") }}</label>
      <input id="mdp" name="mot_de_passe" type="password" autocomplete="current-password" required maxlength="1024">
      <button type="submit" class="btn btn-principal">{{ _("Se connecter") }}</button>
    </form>
    <p class="securite"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><span>{{ _("Vos documents sont chiffrés au repos, avec une clé propre à votre société. Leur contenu est lu comme des données, jamais exécuté.") }}</span></p>
  </section>
</div>
{% endblock %}
