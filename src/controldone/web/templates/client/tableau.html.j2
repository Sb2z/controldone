{% extends "base.html.j2" %}
{% from "macros.html.j2" import badge_niveau, badge_suivi %}
{% from "graphes.html.j2" import graphe %}
{% block contenu %}
<div class="titre-page">
  <h1>{{ info.raison_sociale }}</h1>
  <p class="discret">{{ _("Écarts constatés entre vos documents d'import, validés avant publication.") }}</p>
</div>
<section class="kpis" aria-label="{{ _("Indicateurs") }}">
  <div class="kpi"><div class="kpi-lib">{{ _("Dossiers contrôlés") }}</div><div class="kpi-val num"><a href="/espace/dossiers">{{ kpi.dossiers }}</a></div><div class="kpi-note">{{ _("{n} constat(s) publié(s)", n=kpi.constats) }}</div></div>
  <div class="kpi kpi-accent"><div class="kpi-lib">{{ _("Montant recouvrable certain") }}</div><div class="kpi-val num">{{ kpi.certain|montant }}</div><div class="kpi-note">{{ _("écarts certains validés") }}</div></div>
  <div class="kpi"><div class="kpi-lib">{{ _("Montant à vérifier") }}</div><div class="kpi-val num">{{ kpi.a_verifier|montant }}</div><div class="kpi-note">{{ _("affiché à part, jamais additionné") }}</div></div>
  <div class="kpi"><div class="kpi-lib">{{ _("Écarts sans avoir reçu") }}</div><div class="kpi-val num"><a href="/espace/recouvrement">{{ kpi.reste|montant }}</a></div><div class="kpi-note">{{ _("avoirs reçus : {m}", m=kpi.credite|montant) }}</div></div>
</section>
<div class="grille-2 grille-large-etroite">
<section class="carte">
  <div class="carte-tete"><h2>{{ _("Derniers dossiers") }}</h2><a class="petit-lien" href="/espace/dossiers">{{ _("Tous les dossiers") }}</a></div>
  <div class="defilement">
  <table class="donnees">
    <thead><tr><th scope="col">{{ _("Dossier") }}</th><th scope="col">{{ _("Statut") }}</th><th scope="col">MRN</th><th scope="col" class="num">{{ _("Recouvrable certain") }}</th></tr></thead>
    <tbody>
    {% for d in dossiers %}
    <tr><th scope="row"><a href="/espace/dossiers/{{ d.id }}">{{ d.reference }}</a></th><td>{{ badge_niveau(d.statut_code, d.statut) }}</td><td><code>{{ d.cles[2][1] }}</code></td><td class="num">{{ d.recouvrable_certain|montant if d.recouvrable_certain else "—" }}</td></tr>
    {% else %}<tr><td colspan="4" class="vide">{{ _("Aucun dossier pour l'instant.") }} {% if peut_deposer %}<a href="/espace/depot">{{ _("Déposer des documents") }}</a>.{% endif %}</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>
</section>
<section class="carte">
  <h2>{{ _("Rapports") }}</h2>
  {% if rapports %}
  <ul class="liste-simple">{% for r in rapports|reverse %}<li><span lang="fr">{{ r.payload_effectif.get("objet") }}</span> <span class="discret">{{ r.envoye_le|date(false) }}</span><br>
    <a class="petit-lien" href="/espace/rapports/{{ r.id }}/pdf">PDF</a><a class="petit-lien" href="/espace/rapports/{{ r.id }}/html?afficher=1">{{ _("Version web") }}</a></li>{% endfor %}</ul>
  {% else %}<p class="vide">{{ _("Votre rapport sera disponible ici après validation des constats.") }}</p>{% endif %}
  <h2>{{ _("Derniers dépôts") }}</h2>
  {% if lots %}<ul class="liste-simple" data-suivi-liste="/espace/suivi">{% for l in lots %}<li><a href="/espace/lots/{{ l.id }}">{{ l.recu_le|date }}</a> {{ badge_suivi(l.id, l.suivi) }}</li>{% endfor %}</ul>
  {% else %}<p class="vide">{{ _("Aucun dépôt.") }}</p>{% endif %}
  {% if peut_deposer %}<p><a class="btn btn-principal" href="/espace/depot">{{ _("Déposer des documents") }}</a></p>{% endif %}
</section>
</div>
<section class="graphes" aria-labelledby="t-graphes">
  <h2 id="t-graphes">{{ _("En un coup d'œil") }}</h2>
  <div class="grille-graphes">
    {% for g in graphes %}<div class="carte">{{ graphe(g) }}</div>{% endfor %}
  </div>
</section>
{% endblock %}
