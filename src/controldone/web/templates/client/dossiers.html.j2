{% extends "base.html.j2" %}
{% from "macros.html.j2" import badge_niveau %}
{% from "listes.html.j2" import th_tri, nb_resultats, pagination, fin_filtres %}
{% block contenu %}
<div class="titre-page"><h1>{{ _("Dossiers") }}</h1><p>{{ _("Un dossier regroupe les documents d'un même envoi. Cherchez-le par référence, MRN ou numéro de facture.") }}</p></div>
<section class="carte" aria-labelledby="t-dossiers">
<h2 id="t-dossiers" class="vh">{{ _("Liste des dossiers") }}</h2>
<form method="get" action="/espace/dossiers" class="filtres" role="search" aria-label="{{ _("Filtrer les dossiers") }}" data-filtres>
  <div class="filtre filtre-large">
    <label for="f-q">{{ _("Rechercher") }}</label>
    <input id="f-q" name="q" type="search" value="{{ req.brut.get('q', '') }}" maxlength="80" placeholder="{{ _("Référence, MRN, n° de facture…") }}" autocomplete="off" spellcheck="false">
  </div>
  <div class="filtre">
    <label for="f-statut">{{ _("Statut") }}</label>
    <select id="f-statut" name="statut"><option value="">{{ _("Tous") }}</option>{% for code, lib in statuts.items() %}<option value="{{ code }}"{% if req.brut.get('statut') == code %} selected{% endif %}>{{ _(lib) }}</option>{% endfor %}</select>
  </div>
  {{ fin_filtres(req, "f", "/espace/dossiers") }}
</form>
<div data-resultats>
{{ nb_resultats(p, req, _("dossier"), _("dossiers")) }}
<div class="defilement">
<table class="donnees">
  <caption class="vh">{{ _("Dossiers") }}{% if req.actif %} {{ _("(filtrés)") }}{% endif %}, {{ _("page {n} sur {total}", n=p.page, total=p.pages) }}</caption>
  <thead><tr>{{ th_tri(req, "reference", _("Dossier")) }}<th scope="col">{{ _("Statut") }}</th><th scope="col">{{ _("Facture du transitaire") }}</th><th scope="col">{{ _("Transport") }}</th><th scope="col">MRN</th><th scope="col">{{ _("Facture commerciale") }}</th>{{ th_tri(req, "constats", _("Constats"), "num") }}{{ th_tri(req, "montant", _("Écart certain"), "num") }}</tr></thead>
  <tbody>
  {% for d in p.elements %}
  <tr><th scope="row"><a href="/espace/dossiers/{{ d.id }}">{{ d.reference }}</a></th><td>{{ badge_niveau(d.statut_code, d.statut) }}</td>
    {% for _lib, val in d.cles %}<td><code>{{ val }}</code></td>{% endfor %}
    <td class="num">{{ d.nb_constats }}</td><td class="num">{{ d.recouvrable_certain|montant if d.recouvrable_certain else "—" }}</td></tr>
  {% else %}<tr><td colspan="8" class="vide">{% if req.actif %}{{ _("Aucun dossier ne correspond à ces critères.") }} <a href="/espace/dossiers">{{ _("Afficher tous les dossiers") }}</a>.{% elif total_dossiers == 0 %}{{ _("Vos dossiers apparaîtront ici après votre premier dépôt.") }}{% if peut_deposer %} <a href="/espace/depot">{{ _("Déposer des documents") }}</a>{% endif %}{% else %}{{ _("Aucun dossier sur cette page.") }}{% endif %}</td></tr>{% endfor %}
  </tbody>
</table>
</div>
{{ pagination(p, req, _("Pages des dossiers")) }}
</div>
</section>
{% endblock %}
