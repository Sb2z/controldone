{% macro badge_niveau(code, libelle) -%}
<span class="badge {{ {'ecart_certain': 'b-certain', 'a_verifier': 'b-verifier', 'conforme': 'b-conforme', 'document_manquant': 'b-manquant', 'non_concerne': 'b-neutre', 'en_validation': 'b-neutre', 'en_cours': 'b-neutre'}.get(code, 'b-neutre') }}">{{ _(libelle) }}</span>
{%- endmacro %}

{% macro badge_validation(code, libelle) -%}
<span class="badge {{ {'valide': 'b-valide', 'rejete': 'b-rejete', 'propose': 'b-propose', 'modifie': 'b-valide'}.get(code, 'b-neutre') }}">{{ _(libelle) }}</span>
{%- endmacro %}

{# État de traitement d'un dépôt (D-3402) : mis à jour en direct par app.js (attribut data-lot). #}
{% macro badge_suivi(lot_id, e) -%}
<span class="badge {{ 'b-rejete' if e.erreur else ('b-valide' if e.fini else 'b-verifier en-cours') }}" data-lot="{{ lot_id }}" data-fini="{{ 'oui' if e.fini else 'non' }}">{{ _(e.libelle) }}</span>
{%- endmacro %}

{% macro kpi(libelle, valeur, note=None, ton=None, lien=None) -%}
<div class="kpi{% if ton %} kpi-{{ ton }}{% endif %}">
  <div class="kpi-lib">{{ libelle }}</div>
  <div class="kpi-val num">{% if lien %}<a href="{{ lien }}">{{ valeur }}</a>{% else %}{{ valeur }}{% endif %}</div>
  {% if note %}<div class="kpi-note">{{ note }}</div>{% endif %}
</div>
{%- endmacro %}

{% macro csrf_champ(csrf) -%}<input type="hidden" name="csrf" value="{{ csrf }}">{%- endmacro %}

{# Constat : les deux valeurs côte à côte, la tolérance, la raison, le montant, la preuve (§3.1, §7.7) #}
{% macro constat_carte(c, extraits, base, csrf, retour, fondateur=False, tenant_id=None, client=None, dossier=None) -%}
<article class="constat {{ 'renvoi' if c.renvoi else c.niveau_code }}" id="constat-{{ c.id }}">
  <header class="constat-tete">
    <div class="constat-titre">
      {{ badge_niveau(c.niveau_code, c.niveau) }}
      <span class="controle">{{ c.controle_id }}</span>
      <span class="controle-lib" lang="fr">{{ c.controle_libelle }}</span>
      {% if client %}<span class="contexte">· {{ client }}{% if dossier %} · {{ dossier }}{% endif %}</span>{% endif %}
    </div>
    <div class="constat-montant">
      {% if c.montant_valeur is not none %}<span class="num">{{ c.montant_valeur|montant }}</span>{% endif %}<span class="nature">{{ _(c.nature) }}</span>
    </div>
  </header>
  <p class="libelle" lang="fr">{{ c.libelle }}</p>
  {% if c.raisons %}<ul class="raisons" lang="fr">{% for r in c.raisons %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
  <dl class="meta">
    {% if c.composante %}<div><dt>{{ _("Composante") }}</dt><dd>{{ _(c.composante) }}</dd></div>{% endif %}
    <div><dt>{{ _("Tolérance appliquée") }}</dt><dd class="num">{{ c.tolerance or "—" }}</dd></div>
    <div><dt>{{ _("Seuil de certitude") }}</dt><dd class="num">{{ c.seuil or "—" }}</dd></div>
    {% if fondateur %}<div><dt>{{ _("Validation") }}</dt><dd>{{ badge_validation(c.statut_validation_code, c.statut_validation) }}{% if c.commentaire %} <span class="discret" lang="fr">— {{ c.commentaire }}</span>{% endif %}</dd></div>{% endif %}
  </dl>
  {% if fondateur and c.bloque %}<p class="alerte-ligne">{{ _("Libellé bloqué par les garde-fous :") }} {{ c.motif_blocage }}</p>{% endif %}
  {% if c.preuves %}
  <div class="preuves">
    {% for p in c.preuves %}
    <figure class="preuve">
      <figcaption>
        <span class="preuve-role">{{ _(p.role) }}</span>
        <span class="preuve-doc">{{ p.document }}{% if p.page %}, {{ _("page {n}", n=p.page) }}{% endif %}</span>
      </figcaption>
      {% set img = extraits.get((c.id, p.index)) %}
      {% if img %}<img src="data:image/png;base64,{{ img|b64 }}" alt="{{ _("Extrait de la page {n} : valeur lue {v}", n=p.page, v=p.valeur_lue or "") }}" loading="lazy">{% endif %}
      {% if p.valeur_lue %}<div class="valeur-lue"><span>{{ _("Valeur lue") }}</span> <code>{{ p.valeur_lue }}</code></div>{% endif %}
      {% if p.calcul %}<div class="calcul"><span>{{ _("Calcul") }}</span> <code>{{ p.calcul }}</code></div>{% endif %}
    </figure>
    {% endfor %}
  </div>
  {% endif %}
  {% if c.prochaine_action %}<p class="action"><strong>{{ _("Prochaine action :") }}</strong> <span lang="fr">{{ c.prochaine_action }}</span></p>{% endif %}
  {% if fondateur and c.statut_validation_code == "propose" and tenant_id %}
  <div class="decisions">
    <form method="post" action="/admin/clients/{{ tenant_id }}/constats/{{ c.id }}/valider" class="decision">
      {{ csrf_champ(csrf) }}<input type="hidden" name="retour" value="{{ retour }}">
      <button type="submit" class="btn btn-principal">{{ _("Valider") }}</button>
    </form>
    <form method="post" action="/admin/clients/{{ tenant_id }}/constats/{{ c.id }}/rejeter" class="decision decision-motif">
      {{ csrf_champ(csrf) }}<input type="hidden" name="retour" value="{{ retour }}">
      <label class="vh" for="rej-{{ c.id }}">{{ _("Motif du rejet") }}</label>
      <input id="rej-{{ c.id }}" name="motif" required maxlength="1000" placeholder="{{ _("Motif du rejet (obligatoire)") }}">
      <button type="submit" class="btn">{{ _("Rejeter") }}</button>
    </form>
    {% if c.niveau_code == "ecart_certain" %}
    <form method="post" action="/admin/clients/{{ tenant_id }}/constats/{{ c.id }}/retrograder" class="decision decision-motif">
      {{ csrf_champ(csrf) }}<input type="hidden" name="retour" value="{{ retour }}">
      <label class="vh" for="ret-{{ c.id }}">{{ _("Motif de la rétrogradation") }}</label>
      <input id="ret-{{ c.id }}" name="motif" required maxlength="1000" placeholder="{{ _("Valeur à confirmer : laquelle ?") }}">
      <button type="submit" class="btn">{{ _("Rétrograder en à vérifier") }}</button>
    </form>
    {% else %}
    <p class="discret note-decision">{{ _("Pour en faire un écart certain : corriger ou confirmer la valeur douteuse dans le dossier (le contrôle est relancé).") }}</p>
    {% endif %}
  </div>
  {% endif %}
</article>
{%- endmacro %}
