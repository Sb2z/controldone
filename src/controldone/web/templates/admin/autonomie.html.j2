{% extends "base.html.j2" %}
{% from "macros.html.j2" import csrf_champ %}
{% block contenu %}
<div class="titre-page"><h1>{{ _("Autonomie des actions sortantes") }}</h1>
<p class="discret">{{ _("« Manuel » (défaut) : chaque action attend votre approbation. « Automatique » : approbation automatique si les garde-fous passent ; la mise à disposition reste une étape explicite.") }}</p></div>
<section class="carte">
<table class="donnees">
  <thead><tr><th scope="col">{{ _("Type d'action") }}</th><th scope="col">{{ _("Mode") }}</th><th scope="col">{{ _("Modifier") }}</th></tr></thead>
  <tbody>
  {% for kind, lib, mode in modes %}
  <tr><th scope="row">{{ _(lib) }} <code class="discret">{{ kind }}</code></th>
    <td>{% if mode == "auto" %}<span class="badge b-verifier">{{ _("Automatique") }}</span>{% else %}<span class="badge b-neutre">{{ _("Manuel") }}</span>{% endif %}</td>
    <td><form method="post" action="/admin/autonomie" class="en-ligne">{{ csrf_champ(csrf) }}<input type="hidden" name="kind" value="{{ kind }}">
      <input type="hidden" name="mode" value="{{ 'manuel' if mode == 'auto' else 'auto' }}">
      <button type="submit" class="btn btn-petit">{{ _("Passer en manuel") if mode == "auto" else _("Passer en automatique") }}<span class="vh"> : {{ _(lib) }}</span></button></form></td></tr>
  {% endfor %}
  </tbody>
</table>
</section>
{% endblock %}
