{% extends "base.html.j2" %}
{% from "macros.html.j2" import kpi, badge_niveau, badge_suivi, csrf_champ %}
{% from "graphes.html.j2" import graphe %}
{% set libs = {"ecart_certain": _("Écart certain"), "a_verifier": _("À vérifier"), "conforme": _("Conforme"), "document_manquant": _("Document manquant"), "non_concerne": _("Non concerné"), "inconnu": _("En cours")} %}
{% block contenu %}
<div class="titre-page">
  <h1>{{ _("Tableau de bord") }}</h1>
  <p class="discret">{{ _("Tous les clients. Coûts IA du mois {mois}.", mois=d.mois) }}</p>
</div>
{% if bandeau %}
<section class="bandeau-alertes" aria-labelledby="t-bandeau">
  <div class="carte-tete"><h2 id="t-bandeau">{{ _("Alertes graves non lues") }}</h2>
    <a class="petit-lien" href="/admin/alertes">{{ _("Voir les alertes") }}</a></div>
  <ul>
  {% for b in bandeau %}
    <li><span class="badge b-alerte">{{ _(libelle_alerte(b.kind)) }}</span>
      <span>{{ _("{n} non lue(s), la dernière le {date}", n=b.nombre, date=b.dernier|date) }}</span>
      <form method="post" action="/admin/alertes/bandeau/lues" class="en-ligne">{{ csrf_champ(csrf) }}<input type="hidden" name="kind" value="{{ b.kind }}">
        <button type="submit" class="btn btn-petit">{{ _("Marquer comme lu") }}<span class="vh"> : {{ _(libelle_alerte(b.kind)) }}</span></button></form></li>
  {% endfor %}
  </ul>
  {% if bandeau|length > 1 %}
  <form method="post" action="/admin/alertes/bandeau/lues" class="en-ligne">{{ csrf_champ(csrf) }}<input type="hidden" name="kind" value="tous">
    <button type="submit" class="btn btn-petit">{{ _("Tout marquer comme lu") }}</button></form>
  {% endif %}
</section>
{% endif %}
<section class="kpis" aria-label="{{ _("Indicateurs") }}">
  {{ kpi(_("Constats à valider"), d.totaux.proposes, _("file de validation"), "accent" if d.totaux.proposes else None, "/admin/validation") }}
  {{ kpi(_("Actions sortantes à approuver"), d.totaux.sorties, _("rapports, relevés d'écarts"), None, "/admin/validation#sorties") }}
  {{ kpi(_("Montant recouvrable certain"), d.totaux.recouvrable_certain|montant, _("écarts certains validés")) }}
  {{ kpi(_("Montant recouvrable à vérifier"), d.totaux.recouvrable_a_verifier|montant, _("affiché à part, jamais additionné")) }}
  {{ kpi(_("Reste à recouvrer"), d.totaux.reste_a_recouvrer|montant, _("registre des écarts ouverts")) }}
  {{ kpi(_("Tâches en échec / mortes"), d.totaux.jobs_echec ~ " / " ~ d.totaux.jobs_morts, _("réessais automatiques ; mortes = action requise"), "alerte" if d.totaux.jobs_morts else None, "/admin/jobs") }}
</section>

<div class="grille-2">
<section class="carte">
  <h2>{{ _("Dossiers par statut") }}</h2>
  {% if d.totaux.dossiers %}
  <table class="donnees compacte">
    <thead><tr><th scope="col">{{ _("Statut") }}</th><th scope="col" class="num">{{ _("Dossiers") }}</th><th scope="col" class="barre-col"><span class="vh">{{ _("Proportion") }}</span></th></tr></thead>
    <tbody>
    {% for code, n in d.totaux.par_statut|dictsort(by="value", reverse=true) %}
      <tr><td>{{ badge_niveau(code, libs.get(code, code)) }}</td><td class="num">{{ n }}</td>
      <td class="barre-col"><span class="barre"><span class="w-{{ ((n * 20 / d.totaux.dossiers)|round|int) * 5 }}"></span></span></td></tr>
    {% endfor %}
    </tbody>
    <tfoot><tr><th scope="row">{{ _("Total") }}</th><td class="num">{{ d.totaux.dossiers }}</td><td></td></tr></tfoot>
  </table>
  {% else %}<p class="vide">{{ _("Aucun dossier traité pour l'instant.") }}</p>{% endif %}
</section>

<section class="carte">
  <h2>{{ _("Alertes") }} <a class="petit-lien" href="/admin/alertes">{{ _("tout voir") }}</a></h2>
  {% if d.alertes %}
  <ul class="liste-alertes">
  {% for a in d.alertes[:6] %}
    <li><span class="badge {{ 'b-alerte' if a.kind in ALERTES_GRAVES else 'b-neutre' }}">{{ _(libelle_alerte(a.kind)) }}</span> <span lang="fr">{{ a.message }}</span> <span class="discret">{{ a.cree_le|date }}</span></li>
  {% endfor %}
  </ul>
  {% else %}<p class="vide">{{ _("Aucune alerte non lue.") }}</p>{% endif %}
</section>
</div>

<div class="grille-2">
<section class="carte">{{ graphe(graphes[0]) }}</section>
<section class="carte" aria-labelledby="t-traitements">
  <div class="carte-tete"><h2 id="t-traitements">{{ _("Traitements des dépôts") }}</h2><a class="petit-lien" href="/admin/jobs?kind=traiter_lot">{{ _("Toutes les tâches") }}</a></div>
  {% if traitements.lots %}
  <table class="donnees compacte" data-suivi-liste="/admin/jobs/etat">
    <thead><tr><th scope="col">{{ _("Client") }}</th><th scope="col">{{ _("Dépôt") }}</th><th scope="col">{{ _("État") }}</th></tr></thead>
    <tbody>
    {% for l in traitements.lots %}
      <tr><td><code>{{ l.client or "—" }}</code></td><td><code>{{ l.lot_id[:16] }}</code></td><td>{{ badge_suivi(l.lot_id, l) }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="vide">{{ _("Aucun dépôt traité pour l'instant.") }}</p>{% endif %}
</section>
</div>
<div class="grille-2">
<section class="carte">{{ graphe(graphes[1]) }}</section>
<section class="carte">{{ graphe(graphes[2]) }}</section>
</div>

<section class="carte">
  <h2>{{ _("Clients") }}</h2>
  <div class="defilement">
  <table class="donnees">
    <thead><tr>
      <th scope="col">{{ _("Client") }}</th><th scope="col">{{ _("Offre") }}</th><th scope="col" class="num">{{ _("Dossiers") }}</th>
      <th scope="col" class="num">{{ _("À valider") }}</th><th scope="col" class="num">{{ _("Recouvrable certain") }}</th>
      <th scope="col" class="num">{{ _("À vérifier") }}</th><th scope="col" class="num">{{ _("Écarts ouverts") }}</th>
      <th scope="col">{{ _("Coût IA du mois / plafond") }}</th>
    </tr></thead>
    <tbody>
    {% for c in d.clients %}
      <tr>
        <th scope="row"><a href="/admin/clients/{{ c.id }}">{{ c.raison_sociale }}</a>{% if c.demo %} <span class="badge b-demo">{{ _("Fictif") }}</span>{% endif %}</th>
        <td>{{ _("Diagnostic") if c.offre == "diagnostic" else _("Contrôle continu") }}</td>
        <td class="num">{{ c.stats.get("nb_dossiers", 0) }}</td>
        <td class="num">{% if c.stats.get("proposes", 0) %}<a href="/admin/validation">{{ c.stats.get("proposes") }}</a>{% else %}0{% endif %}</td>
        <td class="num">{{ c.stats.get("recouvrable_certain", 0)|montant }}</td>
        <td class="num">{{ c.stats.get("recouvrable_a_verifier", 0)|montant }}</td>
        <td class="num">{{ c.stats.get("ecarts_ouverts", 0) }}</td>
        <td><span class="jauge{% if c.ratio_ia >= 100 %} jauge-stop{% elif c.ratio_ia >= 80 %} jauge-alerte{% endif %}" role="img" aria-label="{{ _("{n} % du plafond", n=c.ratio_ia) }}"><span class="w-{{ (([c.ratio_ia, 100]|min) / 5)|round|int * 5 }}"></span></span>
          <span class="num">{{ c.cout_ia|montant }} / {{ c.plafond|montant }}</span>{% if c.llm_desactive %} <span class="badge b-neutre">{{ _("Lecture par modèle désactivée") }}</span>{% endif %}</td>
      </tr>
    {% else %}
      <tr><td colspan="8" class="vide">{{ _("Aucun client pour l'instant.") }} <a href="/admin/clients">{{ _("Créer un client") }}</a></td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endblock %}
