{% extends "base.html.j2" %}
{% from "macros.html.j2" import csrf_champ %}
{% from "listes.html.j2" import th_tri, nb_resultats, pagination, fin_filtres %}
{% block contenu %}
<div class="titre-page"><h1>{{ _("Tâches") }}</h1>
<p class="discret">{{ _("File de tâches en base : réessais automatiques (30 s, 60 s, 120 s…), « morte » après 5 essais.") }}</p></div>
<section class="kpis" aria-label="{{ _("Tâches par statut") }}">
  {% for st, lib in [("pending", _("En attente")), ("running", _("En cours")), ("done", _("Terminées")), ("dead", _("Mortes"))] %}
  <div class="kpi{% if st == 'dead' and compte.get('dead') %} kpi-alerte{% endif %}"><div class="kpi-lib">{{ lib }}</div><div class="kpi-val num"><a href="/admin/jobs?statut={{ st }}">{{ compte.get(st, 0) }}</a></div></div>
  {% endfor %}
</section>
<section class="carte" aria-labelledby="t-jobs">
<h2 id="t-jobs" class="vh">{{ _("Liste des tâches") }}</h2>
<form method="get" action="/admin/jobs" class="filtres" role="search" aria-label="{{ _("Filtrer les tâches") }}" data-filtres>
  <div class="filtre">
    <label for="t-statut">{{ _("Statut") }}</label>
    <select id="t-statut" name="statut"><option value="">{{ _("Tous") }}</option>{% for code, lib in statuts.items() %}<option value="{{ code }}"{% if req.brut.get('statut') == code %} selected{% endif %}>{{ _(lib) }}</option>{% endfor %}</select>
  </div>
  <div class="filtre">
    <label for="t-kind">{{ _("Type") }}</label>
    <select id="t-kind" name="kind"><option value="">{{ _("Tous") }}</option>{% for k in kinds %}<option value="{{ k }}"{% if req.brut.get('kind') == k %} selected{% endif %}>{{ k }}</option>{% endfor %}</select>
  </div>
  <div class="filtre">
    <label for="t-client">{{ _("Client") }}</label>
    <select id="t-client" name="client"><option value="">{{ _("Tous") }}</option>{% for c in clients %}<option value="{{ c }}"{% if req.brut.get('client') == c %} selected{% endif %}>{{ c }}</option>{% endfor %}</select>
  </div>
  {{ fin_filtres(req, "t", "/admin/jobs") }}
</form>
<div data-resultats>
{{ nb_resultats(p, req, _("tâche"), _("tâches")) }}
<div class="defilement">
<table class="donnees compacte">
  <caption class="vh">{{ _("Tâches") }}, {{ _("page {n} sur {total}", n=p.page, total=p.pages) }}</caption>
  <thead><tr>{{ th_tri(req, "cree", _("Créée")) }}<th scope="col">{{ _("Prochain essai") }}</th><th scope="col">{{ _("Type") }}</th><th scope="col">{{ _("Client") }}</th><th scope="col">{{ _("Statut") }}</th><th scope="col" class="num">{{ _("Essais") }}</th><th scope="col">{{ _("Dernière erreur") }}</th><th scope="col"><span class="vh">{{ _("Action") }}</span></th></tr></thead>
  <tbody>
  {% for j in p.elements %}
  <tr><td>{{ j.cree_le|date }}</td><td>{% if j.statut == "pending" %}{{ j.run_after|date }}{% if j.attempts %} <span class="discret">({{ _("essai {n}", n=j.attempts + 1) }})</span>{% endif %}{% elif j.statut == "running" %}<span class="discret">{{ _("en cours") }}</span>{% elif j.termine_le %}<span class="discret">{{ _("terminée le {date}", date=j.termine_le|date) }}</span>{% else %}—{% endif %}</td><td><code>{{ j.kind }}</code></td><td><code>{{ j.tenant_id or "—" }}</code></td>
    <td><span class="badge {{ {'done': 'b-valide', 'dead': 'b-rejete', 'running': 'b-verifier'}.get(j.statut, 'b-neutre') }}">{{ _(statuts.get(j.statut, j.statut)) }}</span></td>
    <td class="num">{{ j.attempts }}/{{ j.max_attempts }}</td><td lang="fr">{{ j.last_error or "" }}</td>
    <td>{% if j.statut == "dead" %}<form method="post" action="/admin/jobs/{{ j.id }}/relancer" class="en-ligne">{{ csrf_champ(csrf) }}<input type="hidden" name="retour" value="{{ retour }}"><button class="btn btn-petit" type="submit">{{ _("Relancer") }}<span class="vh"> {{ _("la tâche {kind} {id}", kind=j.kind, id=j.id) }}</span></button></form>{% endif %}</td></tr>
  {% else %}<tr><td colspan="8" class="vide">{% if req.actif %}{{ _("Aucune tâche ne correspond à ces critères.") }}{% else %}{{ _("Aucune tâche.") }}{% endif %}</td></tr>{% endfor %}
  </tbody>
</table>
</div>
{{ pagination(p, req, _("Pages des tâches")) }}
</div>
</section>
{% endblock %}
