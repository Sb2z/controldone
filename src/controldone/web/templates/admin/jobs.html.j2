{% extends "base.html.j2" %}
{% from "macros.html.j2" import csrf_champ %}
{% block contenu %}
<div class="titre-page"><h1>Tâches</h1>
<p class="discret">File de tâches en base : réessais automatiques (30 s, 60 s, 120 s…), « morte » après 5 essais.</p></div>
<section class="kpis">
  {% for st, lib in [("pending", "En attente"), ("running", "En cours"), ("done", "Terminées"), ("dead", "Mortes")] %}
  <div class="kpi{% if st == 'dead' and compte.get('dead') %} kpi-alerte{% endif %}"><div class="kpi-lib">{{ lib }}</div><div class="kpi-val num">{{ compte.get(st, 0) }}</div></div>
  {% endfor %}
</section>
<section class="carte">
<div class="defilement">
<table class="donnees compacte">
  <thead><tr><th scope="col">Créée</th><th scope="col">Type</th><th scope="col">Client</th><th scope="col">Statut</th><th scope="col" class="num">Essais</th><th scope="col">Dernière erreur</th><th scope="col"></th></tr></thead>
  <tbody>
  {% for j in jobs %}
  <tr><td>{{ j.run_after|date }}</td><td><code>{{ j.kind }}</code></td><td><code>{{ j.tenant_id or "—" }}</code></td>
    <td><span class="badge {{ {'done': 'b-valide', 'dead': 'b-rejete', 'running': 'b-verifier'}.get(j.statut, 'b-neutre') }}">{{ {"pending": "En attente", "running": "En cours", "done": "Terminée", "dead": "Morte"}.get(j.statut, j.statut) }}</span></td>
    <td class="num">{{ j.attempts }}/{{ j.max_attempts }}</td><td>{{ j.last_error or "" }}</td>
    <td>{% if j.statut == "dead" %}<form method="post" action="/admin/jobs/{{ j.id }}/relancer" class="en-ligne">{{ csrf_champ(csrf) }}<button class="btn btn-petit" type="submit">Relancer</button></form>{% endif %}</td></tr>
  {% else %}<tr><td colspan="7" class="vide">Aucune tâche.</td></tr>{% endfor %}
  </tbody>
</table>
</div>
</section>
{% endblock %}
