{% extends "base.html.j2" %}
{% block corps_classe %}corps-auth{% endblock %}
{% block contenu %}
<section class="carte carte-etroite">
  <h1>{{ _("Changer de mot de passe") }}</h1>
  {% if erreur is defined %}<div class="message erreur" role="alert">{{ erreur }}</div>{% endif %}
  <form method="post" action="/compte/mot-de-passe" class="formulaire">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label for="actuel">{{ _("Mot de passe actuel") }}</label>
    <input id="actuel" name="actuel" type="password" autocomplete="current-password" required>
    <label for="nouveau">{{ _("Nouveau mot de passe") }} <span class="discret">{{ _("(12 caractères au moins)") }}</span></label>
    <input id="nouveau" name="nouveau" type="password" autocomplete="new-password" minlength="12" required>
    <label for="confirmation">{{ _("Confirmation") }}</label>
    <input id="confirmation" name="confirmation" type="password" autocomplete="new-password" minlength="12" required>
    <button type="submit" class="btn btn-principal">{{ _("Enregistrer") }}</button>
  </form>
</section>
{% endblock %}
