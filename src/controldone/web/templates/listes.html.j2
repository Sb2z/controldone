{# Listes : en-têtes triables, nombre de résultats, pagination (D-3401). Liens GET, utilisables sans JavaScript. #}

{% macro th_tri(req, cle, libelle, classe="") -%}
<th scope="col"{% if classe %} class="{{ classe }}"{% endif %} aria-sort="{{ req.sens(cle) }}"><a class="tri" href="{{ req.url_tri(cle) }}">{{ libelle }}<span class="tri-ico" aria-hidden="true">{{ {"ascending": "↑", "descending": "↓"}.get(req.sens(cle), "↕") }}</span><span class="vh">{{ {"ascending": _(" (tri croissant, activer pour décroissant)"), "descending": _(" (tri décroissant, activer pour croissant)")}.get(req.sens(cle), _(" (trier)")) }}</span></a></th>
{%- endmacro %}

{% macro nb_resultats(p, req, singulier, pluriel) -%}
<p class="compte-resultats" data-compte>
{%- if p.total == 0 -%}{{ _("Aucun résultat ne correspond aux filtres.") if req.actif else _("Aucun résultat.") }}
{%- elif p.pages == 1 -%}{{ p.total }} {{ singulier if p.total == 1 else pluriel }}{% if req.actif %} {{ _("(filtré)") }}{% endif %}.
{%- else -%}{{ _("{debut}–{fin} sur {total}", debut=p.debut, fin=p.fin, total=p.total) }} {{ pluriel }}{% if req.actif %} {{ _("(filtré)") }}{% endif %}.
{%- endif -%}
</p>
{%- endmacro %}

{% macro pagination(p, req, libelle) -%}
{% if p.pages > 1 %}
<nav class="pagination" aria-label="{{ libelle }}">
  {% if p.page > 1 %}<a href="{{ req.url(page=p.page - 1) }}" rel="prev">‹ {{ _("Précédente") }}</a>{% else %}<span class="inactif" aria-hidden="true">‹ {{ _("Précédente") }}</span>{% endif %}
  <ul>
  {% for n in p.numeros %}
    {% if n is none %}<li><span class="ellipse" aria-hidden="true">…</span></li>
    {% elif n == p.page %}<li><a href="{{ req.url(page=n) }}" aria-current="page"><span class="vh">{{ _("Page") }} </span>{{ n }}</a></li>
    {% else %}<li><a href="{{ req.url(page=n) }}"><span class="vh">{{ _("Page") }} </span>{{ n }}</a></li>{% endif %}
  {% endfor %}
  </ul>
  {% if p.page < p.pages %}<a href="{{ req.url(page=p.page + 1) }}" rel="next">{{ _("Suivante") }} ›</a>{% else %}<span class="inactif" aria-hidden="true">{{ _("Suivante") }} ›</span>{% endif %}
</nav>
{% endif %}
{%- endmacro %}

{# Champs communs en fin de formulaire de filtres : taille de page, boutons, réinitialisation. #}
{% macro fin_filtres(req, id, chemin, tri_cache=True) -%}
<div class="filtre filtre-taille">
  <label for="{{ id }}-taille">{{ _("Par page") }}</label>
  <select id="{{ id }}-taille" name="taille">{% for t in (25, 50, 100) %}<option value="{{ t }}"{% if req.taille == t %} selected{% endif %}>{{ t }}</option>{% endfor %}</select>
</div>
{% if tri_cache and req.tri != req.tri_defaut %}<input type="hidden" name="tri" value="{{ req.tri }}">{% endif %}
<div class="filtre filtre-actions">
  <button type="submit" class="btn">{{ _("Filtrer") }}</button>
  {% if req.actif or req.tri != req.tri_defaut %}<a class="petit-lien" href="{{ chemin }}{{ req.ancre }}">{{ _("Réinitialiser") }}</a>{% endif %}
</div>
{%- endmacro %}
