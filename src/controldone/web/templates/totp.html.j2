{% extends "base.html.j2" %}
{% block corps_classe %}corps-auth{% endblock %}
{% block contenu %}
<section class="carte carte-etroite">
  <h1>{{ _("Code de vérification") }}</h1>
  <p class="discret">{{ _("Ouvrez votre application d'authentification et saisissez le code à six chiffres affiché pour ControlDOne.") }}</p>
  {% if erreur is defined %}<div class="message erreur" role="alert"><span class="texte">{{ erreur }}</span></div>{% endif %}
  <form method="post" action="/connexion/totp" class="formulaire">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label for="code">{{ _("Code") }}</label>
    <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus class="code">
    <button type="submit" class="btn btn-principal">{{ _("Confirmer") }}</button>
  </form>
  <p><a href="/connexion">{{ _("Revenir à la connexion") }}</a></p>
</section>
{% endblock %}
