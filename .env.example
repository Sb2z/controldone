# Copier en .env et compléter. Aucun secret dans le dépôt. Le fichier .env (répertoire courant, ou
# CONTROLDONE_ENV_FILE) est lu par TOUTES les lectures de réglages (D-1310) ; l'environnement réel l'emporte.

# Base de données (SQLite par défaut, PostgreSQL possible — D-003)
CONTROLDONE_DATABASE_URL=sqlite:///var/controldone.db
CONTROLDONE_DATA_DIR=var

# Extracteur « llm » : activé seulement si la clé est définie (D-006)
ANTHROPIC_API_KEY=
CONTROLDONE_LLM_MODEL=claude-opus-5-5
# Taux de conversion USD -> EUR pour le calcul du coût IA (hypothèse, à mettre à jour)
CONTROLDONE_USD_EUR=0.92
# Plafonds de coût IA (SPEC §20.5) : par lot traité ; plafonds mensuels par défaut d'un nouveau client
CONTROLDONE_LLM_PLAFOND_DOSSIER_EUR=0.50
CONTROLDONE_LLM_PLAFOND_CLIENT_MENSUEL_EUR=8.00
CONTROLDONE_LLM_PLAFOND_DIAGNOSTIC_EUR=20.00
# Confiance attribuée à une valeur llm ancrée (non ancrée : plafonnée à 0,50)
CONTROLDONE_LLM_CONFIANCE_ANCREE=0.85
# Repli côté serveur en cas de refus du modèle (fallbacks "default")
CONTROLDONE_LLM_FALLBACKS=true

# Mode déterministe (identifiants reproductibles pour le banc)
CONTROLDONE_SEED=
CONTROLDONE_LOG_LEVEL=INFO

# Plateforme (docs/SECURITY.md, docs/EXPLOITATION.md)
# Mode : dev | test | prod (en prod, MASTER_KEY et SECRET_KEY sont obligatoires : refus de démarrer sinon)
CONTROLDONE_ENV=dev
# Clé(s) Fernet, séparées par des virgules (la première chiffre). Générer :
#   python -c "from controldone.storage import nouvelle_cle; print(nouvelle_cle())"
CONTROLDONE_MASTER_KEY=
# Secret(s) de signature des sessions (>= 32 caractères ; la dernière valeur signe)
CONTROLDONE_SECRET_KEY=
CONTROLDONE_JOB_LEASE_S=120
CONTROLDONE_JOB_POLL_S=2
# Durée maximale d'un lot (s, 0 = sans limite) ; répertoire temporaire (défaut <data_dir>/tmp)
CONTROLDONE_LOT_DUREE_MAX_S=0
# CONTROLDONE_TMP_DIR=
