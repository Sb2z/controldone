# Copier en .env et compléter. Aucun secret dans le dépôt.

# Base de données (SQLite par défaut, PostgreSQL possible — D-003)
CONTROLDONE_DATABASE_URL=sqlite:///var/controldone.db
CONTROLDONE_DATA_DIR=var

# Extracteur « llm » : activé seulement si la clé est définie (D-006)
ANTHROPIC_API_KEY=
CONTROLDONE_LLM_MODEL=claude-opus-5-5
# Taux de conversion USD -> EUR pour le calcul du coût IA (hypothèse, à mettre à jour)
CONTROLDONE_USD_EUR=0.92
# Plafonds de coût IA (SPEC §20.5)
CONTROLDONE_LLM_PLAFOND_DOSSIER_EUR=0.50
CONTROLDONE_LLM_PLAFOND_CLIENT_MENSUEL_EUR=8.00
# Confiance attribuée à une valeur llm ancrée (non ancrée : plafonnée à 0,50)
CONTROLDONE_LLM_CONFIANCE_ANCREE=0.85
# Repli côté serveur en cas de refus du modèle (fallbacks "default")
CONTROLDONE_LLM_FALLBACKS=true

# Mode déterministe (identifiants reproductibles pour le banc)
CONTROLDONE_SEED=
CONTROLDONE_LOG_LEVEL=INFO
