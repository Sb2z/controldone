# ControlDOne v2 — variables de production (modèle). AUCUNE VALEUR RÉELLE ICI.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod && ln -s .env.prod .env
#
# .env.prod est ignoré par git (.gitignore). Il est lu par docker compose de deux façons :
#   - env_file   : variables transmises aux conteneurs web, worker, scheduler (pas à caddy) ;
#   - lien .env  : interpolation dans docker-compose.yml (domaine, chemins hôte, version).
# Les variables optionnelles sont commentées : une ligne « VAR= » vide vaut chaîne vide, pas « absente ».
# Conserver une copie des clés HORS de la machine (gestionnaire de mots de passe + copie papier sous scellé) :
# sans CONTROLDONE_MASTER_KEY, le coffre et les sauvegardes sont illisibles.

# =====================================================================================================
# 1. Docker compose (interpolation, lu via le lien .env)
# =====================================================================================================
# Nom de domaine public servi par Caddy (enregistrement DNS A/AAAA vers l'IP de la VM). Ex. app.exemple.fr
# Lu aussi par l'application (D-3602) : URL des liens de paiement Stripe (https://<domaine>, jamais l'en-tête Host)
# et seuls hôtes admis dans l'en-tête Host (400 sinon ; la boucle locale reste admise pour la sonde de santé).
CONTROLDONE_DOMAIN=
# Facultatif : URL publique différente (https://hôte[:port], sans chemin) ; hôtes supplémentaires admis (virgules).
# CONTROLDONE_URL_PUBLIQUE=
# CONTROLDONE_HOTES_AUTORISES=
# Facultatif (D-3605) : 1 = la base est sur un disque chiffré par l'hébergeur, invisible depuis la VM. Sans cela, une
# base détectée hors volume chiffré (LUKS) donne une alerte « volume_non_chiffre » au démarrage du service web.
# CONTROLDONE_VOLUME_CHIFFRE=
# Adresse de contact pour Let's Encrypt (avis d'expiration). Ex. technique@exemple.fr
ACME_EMAIL=
# Répertoires de l'hôte, sur le volume chiffré (LUKS) monté en /srv/controldone. Propriétaire uid 10001.
CONTROLDONE_HOST_VAR=/srv/controldone/var
CONTROLDONE_HOST_BACKUPS=/srv/controldone/backups
CONTROLDONE_HOST_CADDY=/srv/controldone/caddy
# Étiquette de l'image construite (changer à chaque mise à jour pour pouvoir revenir en arrière).
CONTROLDONE_VERSION=2.0.0
# Heure UTC (HHMM) de la sauvegarde quotidienne faite par le conteneur scheduler.
SCHED_BACKUP_HHMM=0215
# Sauvegardes (conteneur scheduler, deploy/backup-cron.sh ; voir deploy/README.md « Sauvegardes ») :
# conservation locale (une par jour sur N jours, une par semaine ISO sur N semaines).
# BACKUP_JOURS=7
# BACKUP_SEMAINES=4
# Jour de la restauration d'essai complète de l'archive du jour : 1 = lundi … 7 = dimanche, 0 = jamais, tous.
# BACKUP_VERIFICATION_PROFONDE_JOUR=7
# Sonde « homme mort » (type Healthchecks, auto-hébergeable) : <url>/0 si succès, <url>/<code> si échec.
# Alerte par courriel si aucun signal pendant 26 h (sauvegarde qui ne tourne plus du tout).
# BACKUP_PING_URL=
# Attente maximale (s) du verrou de maintenance quand une purge est en cours au moment de la sauvegarde (D-3504).
# BACKUP_VERROU_ATTENTE_S=1800
# PostgreSQL seulement : serveur de VÉRIFICATION (droit CREATEDB) où la restauration d'essai hebdomadaire charge
# le dump dans une base jetable, supprimée ensuite (D-3501). Sans lui, le dump est seulement relu.
# BACKUP_PG_VERIFICATION_URL=postgresql+pg8000://verification:motdepasse@hote-verification:5432/postgres

# =====================================================================================================
# 2. Plateforme (obligatoire) — docs/SECURITY.md § 3.2
# =====================================================================================================
# prod : refuse de démarrer sans MASTER_KEY ni SECRET_KEY. Ne jamais mettre dev en production.
CONTROLDONE_ENV=prod
# Clé(s) Fernet (32 octets base64), séparées par des virgules : la première chiffre, toutes déchiffrent.
# Générer : docker compose run --rm --no-deps web python -c "from controldone.storage import nouvelle_cle; print(nouvelle_cle())"
CONTROLDONE_MASTER_KEY=
# Secret(s) de signature des sessions et du CSRF (>= 32 caractères ; la DERNIÈRE valeur signe).
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CONTROLDONE_SECRET_KEY=
# Niveau des journaux : DEBUG | INFO | WARNING | ERROR
CONTROLDONE_LOG_LEVEL=INFO
# Base et données : déjà fixées dans l'image (SQLite sur le volume /app/var). Ne changer que pour PostgreSQL
# (pilote pg8000, licence BSD ; l'image doit alors contenir pg8000 et postgresql-client — voir
# docs/backlog/production.md) :
# CONTROLDONE_DATABASE_URL=postgresql+pg8000://utilisateur:motdepasse@hote:5432/controldone
# CONTROLDONE_DATA_DIR=/app/var
# Migrations de schéma (D-3503) : par défaut le web et le worker REFUSENT de démarrer (code 3) tant qu'une
# migration est en attente ; lancer « controldone migrer » (sauvegarde d'abord). 1 = migrer au démarrage.
# CONTROLDONE_MIGRATION_AUTO=

# =====================================================================================================
# 3. File de tâches (worker) — docs/EXPLOITATION.md § 2
# =====================================================================================================
# Bail d'un job en secondes (battement de cœur tous les tiers de bail) et attente entre deux recherches.
CONTROLDONE_JOB_LEASE_S=120
CONTROLDONE_JOB_POLL_S=2
# Durée maximale du traitement d'un lot (s) : le pipeline tourne dans un processus fils, tué au-delà ; le
# job devient « dead » (alerte) et le worker passe au lot suivant (D-1311). 0 = sans limite.
CONTROLDONE_LOT_DUREE_MAX_S=1800
# Conservation des jobs terminés (jours) ; clôture automatique des dossiers inactifs (jours, D-1301).
# CONTROLDONE_JOBS_CONSERVATION_JOURS=30
# CONTROLDONE_CLOTURE_AUTO_JOURS=60
# Répertoire temporaire (téléversements, déchiffrement des lots) : sur le volume, pas sur le tmpfs /tmp (D-1305).
CONTROLDONE_TMP_DIR=/app/var/tmp
# Dépôts traités en même temps par le processus web.
# CONTROLDONE_DEPOTS_SIMULTANES=2

# =====================================================================================================
# 4. Modèle de langage (facultatif) — sans clé, seuls les extracteurs structure et deterministe tournent
# =====================================================================================================
# Clé API Anthropic (sk-ant-…). Optionnelle.
# ANTHROPIC_API_KEY=
# CONTROLDONE_LLM_MODEL=claude-opus-5-5
# CONTROLDONE_LLM_MAX_TOKENS=16000
# Repli côté serveur en cas de refus du modèle.
# CONTROLDONE_LLM_FALLBACKS=true
# Taux USD -> EUR pour le calcul du coût IA (hypothèse à tenir à jour).
# CONTROLDONE_USD_EUR=0.92
# Plafonds de coût IA en EUR (SPEC §20.5) : par lot traité (passé au pipeline par le worker), et plafonds
# mensuels **par défaut** d'un nouveau client « continu » / « diagnostic » (colonne du client, modifiable
# ensuite sur sa fiche). Lus par config.Settings (D-1310).
# CONTROLDONE_LLM_PLAFOND_DOSSIER_EUR=0.50
# CONTROLDONE_LLM_PLAFOND_CLIENT_MENSUEL_EUR=8.00
# CONTROLDONE_LLM_PLAFOND_DIAGNOSTIC_EUR=20.00
# Confiance attribuée à une valeur llm ancrée dans le texte (non ancrée : plafonnée à 0,50).
# CONTROLDONE_LLM_CONFIANCE_ANCREE=0.85

# =====================================================================================================
# 5. Paiement Stripe (facultatif) — docs/FACTURATION.md ; sans clé : simulateur hors ligne
# =====================================================================================================
# sk_test_… pour commencer. Une clé sk_live_… n'est acceptée qu'avec CONTROLDONE_ENV=prod ET STRIPE_LIVE_OK=1.
# STRIPE_SECRET_KEY=
# Secret de signature du point de terminaison https://<CONTROLDONE_DOMAIN>/webhooks/stripe (whsec_…).
# STRIPE_WEBHOOK_SECRET=
# Mettre 1 seulement au passage en encaissement réel, après les essais en mode test.
# STRIPE_LIVE_OK=

# =====================================================================================================
# 6. Mentions du vendeur sur les factures Factur-X (sinon lues dans config/offres.yaml, « À COMPLÉTER »)
# =====================================================================================================
# CONTROLDONE_VENDEUR_RAISON_SOCIALE=
# CONTROLDONE_VENDEUR_FORME_JURIDIQUE=
# CONTROLDONE_VENDEUR_SIREN=
# CONTROLDONE_VENDEUR_RCS=
# CONTROLDONE_VENDEUR_TVA_INTRACOM=
# CONTROLDONE_VENDEUR_ADRESSE_LIGNE=
# CONTROLDONE_VENDEUR_CODE_POSTAL=
# CONTROLDONE_VENDEUR_VILLE=
# CONTROLDONE_VENDEUR_PAYS=FR
# CONTROLDONE_VENDEUR_EMAIL=
# CONTROLDONE_VENDEUR_IBAN=
# CONTROLDONE_VENDEUR_BIC=
# Adresse de réception de factures électroniques (plateforme agréée), si connue.
# CONTROLDONE_VENDEUR_ADRESSE_ELECTRONIQUE=
# Identifiant interne du vendeur (laisser la valeur par défaut).
# CONTROLDONE_VENDEUR_IDENTIFIANT=fondateur
# 1/true/oui : TVA facturée ; 0 : franchise en base (mention art. 293 B du CGI).
# CONTROLDONE_TVA_APPLICABLE=

# =====================================================================================================
# 7. Agents, connecteurs, référentiel — docs/EXPLOITATION.md § 7, docs/AGENTS.md
# =====================================================================================================
# 1 : la veille télécharge les sources officielles (liste blanche) ; sinon « non vérifié ».
# CONTROLDONE_VEILLE_RESEAU=
# Sel du hachage des transitaires dans le référentiel anonymisé (sinon dérivé de la clé maîtresse).
# CONTROLDONE_REFERENTIEL_SEL=
# Mot de passe d'une boîte IMAP dédiée d'un client : nom libre, cité par
# reglages["connecteurs"]["imap"]["secret_env"] du client. Une ligne par boîte.
# CONTROLDONE_IMAP_CLIENT_EXEMPLE=

# =====================================================================================================
# 8. Notifications poussées des alertes (facultatif, D-3502) — RIEN N'EST ENVOYÉ si rien n'est défini ici
# =====================================================================================================
# Ce qui part : type d'alerte, libellé fixe, nombre, horodatage et le chemin /admin/alertes. Jamais de donnée
# client (ni message, ni client, ni fichier). Une notification par type et par jour. Production seulement.
# Webhook (POST JSON ; HTTPS obligatoire). Slack / Mattermost : URL du webhook entrant (champ « text »).
# Healthchecks : https://<instance>/ping/<uuid>/fail. ntfy : https://<instance>/<sujet> avec le format texte.
# CONTROLDONE_NOTIF_WEBHOOK_URL=
# CONTROLDONE_NOTIF_WEBHOOK_FORMAT=json
# Courriel (SMTP authentifié ; starttls sur 587 par défaut, ou ssl sur 465). Destinataires fixes, séparés par
# des virgules. Le mot de passe n'est jamais journalisé.
# CONTROLDONE_NOTIF_SMTP_HOTE=
# CONTROLDONE_NOTIF_SMTP_PORT=587
# CONTROLDONE_NOTIF_SMTP_SECURITE=starttls
# CONTROLDONE_NOTIF_SMTP_UTILISATEUR=
# CONTROLDONE_NOTIF_SMTP_MOT_DE_PASSE=
# CONTROLDONE_NOTIF_COURRIEL_DE=
# CONTROLDONE_NOTIF_COURRIEL_A=
# Types notifiés (défaut : tous), ex. sauvegarde_echec,sauvegarde_verification_echec,sauvegarde_absente,job_mort
# CONTROLDONE_NOTIF_TYPES=
# Essai après configuration : docker compose exec scheduler controldone alertes essai

# =====================================================================================================
# 9. Divers (rarement utiles en production)
# =====================================================================================================
# Cache des pages rendues (accélère les relances ; doit être sous /app/var ou /tmp).
# (Le cache de pages en clair est ignoré en production : ne pas définir CONTROLDONE_PAGES_CACHE_DIR.)
# Répertoire du référentiel de taux (défaut : /app/ref de l'image).
# CONTROLDONE_REF_DIR=
# Mode déterministe du banc : NE PAS définir en production.
# CONTROLDONE_SEED=
# Serveur MCP (python -m controldone.mcp_server) : il a besoin de la base et de la clé maîtresse, il tourne
# donc sur la machine du service (docs/MCP.md), jamais sur le poste du client ; clé d'API client et
# répertoire autorisé.
# CONTROLDONE_MCP_API_KEY=
# CONTROLDONE_MCP_RACINE=
# Adresses du mandataire dont web croit les en-têtes X-Forwarded-* : fixée dans docker-compose.yml
# (--forwarded-allow-ips 172.30.57.10, adresse fixe de caddy).
# CONTROLDONE_FORWARDED_ALLOW_IPS=

# =====================================================================================================
# 10. Copie hors site (sur l'HÔTE seulement : deploy/backup-cron.sh --hors-site, crontab root)
# =====================================================================================================
# Distant rclone vers un stockage objet UE (ex. objeu:controldone-sauvegardes ; voir docs/DEPLOIEMENT.md).
# BACKUP_RCLONE_REMOTE=
# BACKUP_HOST_DIR=/srv/controldone/backups
# Âge maximal (heures) de la dernière archive locale avant alerte (code 4).
# BACKUP_AGE_MAX_H=26
# Fichier compose : un échec hors site est aussi inscrit dans /admin/alertes (docker compose exec scheduler).
# BACKUP_ALERTE_COMPOSE=/srv/controldone/app/deploy/docker-compose.yml
# Sonde « homme mort » distincte pour la copie hors site (voir plus haut).
# BACKUP_PING_URL=

# Nombre de fichiers d'un lot dont l'OCR tourne en parallèle (défaut : min(processeurs, 4)).
# Chaque processus d'OCR peut prendre ~400 Mo : sur une machine de 2 Go, mettre 2.
CONTROLDONE_PAGES_PARALLELE=2
